class PlayerTeam {
    field Array team;
    field int activeIndex;

    constructor PlayerTeam new() {
        let team = Array.new(6);
        let activeIndex = 0;
        do initializeStarterTeam();
        return this;
    }

    method void setPokemon(int index, Pokemon p) {
        let team[index] = p;
        return;
    }

    method Pokemon getPokemon(int index) {
        return team[index];
    }

    method void setActive(int index) {
        let activeIndex = index;
        return;
    }

    method Pokemon getActive() {
        return team[activeIndex];
    }

    method int getActiveIndex() {
        return activeIndex;
    }

    method void addPokemon(int index, String name, int hp, String weakness, String resistance,
                            String attack0, int dmg0, String type0,
                            String attack1, int dmg1, String type1,
                            String attack2, int dmg2, String type2,
                            String attack3, int dmg3, String type3) {
        var Pokemon p;
        let p = Pokemon.new(name, hp, weakness, resistance);
        do p.setAttack(0, attack0, dmg0, type0);
        do p.setAttack(1, attack1, dmg1, type0);
        do p.setAttack(2, attack2, dmg2, type0);
        do p.setAttack(3, attack3, dmg3, type0);
        let team[index] = p;
        return;
    }

    method void initializeStarterTeam() {
        do addPokemon(0, "Typhlosion", 80, "water", "grass",
                        "Flamethrower", 30, "fire",
                        "Take Down", 20, "normal",
                        "Ember", 20, "fire",
                        "Brick Break", 20, "fighting");
        
        do addPokemon(1, "Feraligatr", 85, "grass", "fire",
                        "Water Gun", 30, "water",
                        "Ice Fang", 25, "ice",
                        "Surf", 35, "water",
                        "Bite", 15, "dark");

        do addPokemon(2, "Meganium", 80, "fire", "water",
                        "Razor Leaf", 20, "grass",
                        "Magical Leaf", 30, "grass",
                        "Take Down", 20, "normal",
                        "Body Slam", 20, "normal");

        do addPokemon(3, "Gengar", 60, "ground", "grass",
                        "Shadow Ball", 40, "ghost",
                        "Fire Punch", 25, "fire",
                        "Thunder Punch", 25, "electric",
                        "Ice Punch", 25, "ice");

        do addPokemon(4, "Heracross", 70, "fire", "grass",
                        "Close Combat", 35, "fighting",
                        "Rock Smash", 20, "rock",
                        "Fury Cutter", 25, "bug",
                        "Headbutt", 20, "normal");

        do addPokemon(5, "Sudowoodo", 70, "grass", "fire",
                        "Stone Edge", 30, "rock",
                        "Fire Punch", 25, "fire",
                        "Thunder Punch", 25, "thunder",
                        "Ice Punch", 25, "ice");
        return;
    }

    method void drawPokemon(int index, int location) {
        if (index = 0) {
            do drawTyphlosion(location);
        }
        if (index = 1) {
            do drawFeraligatr(location);
        }
        if (index = 2) {
            do drawMeganium(location);
        }
        if (index = 3) {
            do drawGengar(location);
        }
        if (index = 4) {
            do drawHeracross(location);
        }
        if (index = 5) {
            do drawSudowoodo(location);
        }
        return;
    }

    method void clearPokemon(int index, int location) {
        if (index = 0) {
            do clearTyphlosion(location);
        }
        if (index = 1) {
            do clearFeraligatr(location);
        }
        if (index = 2) {
            do clearMeganium(location);
        }
        if (index = 3) {
            do clearGengar(location);
        }
        if (index = 4) {
            do clearHeracross(location);
        }
        if (index = 5) {
            do clearSudowoodo(location);
        }
        return;
    }

