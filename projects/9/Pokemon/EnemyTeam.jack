class EnemyTeam {
    field Array team;
    field int activeIndex;

    constructor EnemyTeam new() {
        let team = Array.new(6);
        let activeIndex = 0;
        do initializeStarterTeam();
        return this;
    }

    method void setPokemon(int index, Pokemon p) {
        let team[index] = p;
        return;
    }

    method Pokemon getPokemon(int index) {
        return team[index];
    }

    method void setActive(int index) {
        let activeIndex = index;
        return;
    }

    method Pokemon getActive() {
        return team[activeIndex];
    }

    method int getActiveIndex() {
        return activeIndex;
    }

    method void addPokemon(int index, String name, int hp, String weakness, String resistance,
                            String attack0, int dmg0, String type0) {
        var Pokemon p;
        let p = Pokemon.new(name, hp, weakness, resistance);
        do p.setAttack(0, attack0, dmg0, type0);
        let team[index] = p;
        return;
    }

    method void initializeStarterTeam() {
        do addPokemon(0, "Pikachu", 90, "ground", "electric",
                        "Thundershock", 30, "electric");

        do addPokemon(1, "Snorlax", 100, "fighting", "ghost",
                        "Bodyslam", 20, "normal");
        
        do addPokemon(2, "Lapras", 80, "grass", "fire",
                        "Surf", 35, "water");

        do addPokemon(3, "Venusaur", 80, "fire", "water",
                        "Magical Leaf", 30, "grass");

        do addPokemon(4, "Charizard", 80, "water", "grass",
                        "Flamethrower", 30, "fire");

        do addPokemon(5, "Blastoise", 90, "grass", "fire",
                        "Hydro Pump", 40, "water");

        return;
    }

    method void drawPokemon(int index, int location) {
        if (index = 0) {
            do drawPikachu(location);
        }
        if (index = 1) {
            do drawSnorlax(location);
        }
        if (index = 2) {
            do drawLapras(location);
        }
        if (index = 3) {
            do drawVenusaur(location);
        }
        if (index = 4) {
            do drawCharizard(location);
        }
        if (index = 5) {
            do drawBlastoise(location);
        }
        return;
    }

    method void clearPokemon(int index, int location) {
        if (index = 0) {
            do clearPikachu(location);
        }
        if (index = 1) {
            do clearSnorlax(location);
        }
        if (index = 2) {
            do clearLapras(location);
        }
        if (index = 3) {
            do clearVenusaur(location);
        }
        if (index = 4) {
            do clearCharizard(location);
        }
        if (index = 5) {
            do clearBlastoise(location);
        }
        return;
    }

